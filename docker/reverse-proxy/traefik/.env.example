# Traefik Environment Variables
# Copy this file to .env and configure it
# NEVER commit .env to version control

# Email for Let's Encrypt notifications
TRAEFIK_EMAIL=admin@example.com

# Dashboard password (bcrypt hashed)
# IMPORTANT: In .env files, $ must be escaped as $$ for Docker Compose
#
# Generate password hash:
#   htpasswd -nb admin yourpassword
#
# Then escape $ as $$ for .env file:
#   Original: admin:$apr1$abc123$hash
#   In .env: admin:$$apr1$$abc123$$hash
#
TRAEFIK_DASHBOARD_PASSWORD=admin:$$apr1$$hash...
